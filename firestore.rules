rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Root Collections (Legacy / Demo Data - Read-only):
//   - /obras/{obraId}
//   - /tareas/{tareaId}
//
// User-Isolated Collections:
// Collection: /users/{userId}/obras
// Document ID: obraId (string)
// Fields:
//   - id: string (required, 1-100 chars, must match document ID)
//   - nombre: string (required, 1-200 chars)
//   - activo: bool | number (required, 0, 1, false, or true)
//
// Collection: /users/{userId}/tareas
// Document ID: tareaId (string)
// Fields:
//   - id: string (required, 1-100 chars, must match document ID)
//   - obra_id: string (required, 1-100 chars)
//   - fecha_semana: string (required, YYYY-MM-DD, 10 chars)
//   - dia_semana: string (required, 'Lunes'..'Domingo')
//   - actividad: string (required, 1-1000 chars)
//   - gremio: string (required, 1-100 chars)
//   - completada: bool | number (required, 0, 1, false, or true)
//   - notas: string (optional, 0-2000 chars)
//   - trazo_data: string | null (optional, max 600000 chars)
//   - fecha_creado: string (required, ISO 8601 string, immutable)
//
// Collection: /users/{userId}/notas
// Document ID: notaId (string)
// Fields:
//   - id: string (required, 1-100 chars, must match document ID, immutable)
//   - texto: string | null (optional, 0-5000 chars)
//   - completada: bool | number (required, 0, 1, false, or true)
//   - fecha_creacion: string (required, ISO 8601 string, immutable)
//   - fecha_completada: string | null (optional, ISO 8601 string if present)
//   - tipo: string (required, 'texto' | 'trazo')
//   - trazo_data: string | null (optional, max 600000 chars)
//   - prioridad: string | null (optional, 'normal' | 'urgente' | 'repaso')
//   - obra_id: string | null (optional, 0-100 chars)
//
// Collection: /users/{userId}
// Document ID: userId (string, e.g. 'u_nombre_apellido_enue_es')
//
// Access Control:
// Users access their private space via verified corporate email (@enue.es).
// Data is strictly isolated per userId path.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isValidUserId(userId) {
      return userId is string && userId.size() > 0 && userId.size() <= 128;
    }

    function isValidFlag(val) {
      return val is bool || (val is number && (val == 0 || val == 1));
    }

    function isValidDiaSemana(dia) {
      return dia is string &&
        dia in [
          'Lunes', 'Martes', 'Miércoles', 'Miercoles',
          'Jueves', 'Viernes', 'Sábado', 'Sabado', 'Domingo'
        ];
    }

    function isValidOptionalNotas(data) {
      return !('notas' in data) ||
        (data.notas is string && data.notas.size() <= 2000);
    }

    function isValidOptionalTexto(data) {
      return !('texto' in data) ||
        data.texto == null ||
        (data.texto is string && data.texto.size() <= 5000);
    }

    function isValidOptionalFechaCompletada(data) {
      return !('fecha_completada' in data) ||
        data.fecha_completada == null ||
        (data.fecha_completada is string &&
          data.fecha_completada.size() >= 10 &&
          data.fecha_completada.size() <= 50 &&
          data.fecha_completada.matches('^\\d{4}-\\d{2}-\\d{2}T.*'));
    }

    function isValidTipoNota(tipo) {
      return tipo is string && tipo in ['texto', 'trazo'];
    }

    function isValidOptionalTrazoData(data) {
      return !('trazo_data' in data) ||
        data.trazo_data == null ||
        (data.trazo_data is string && data.trazo_data.size() <= 600000);
    }

    function isValidOptionalPrioridad(data) {
      return !('prioridad' in data) ||
        data.prioridad == null ||
        (data.prioridad is string && data.prioridad in ['normal', 'urgente', 'repaso']);
    }

    function isValidOptionalObraId(data) {
      return !('obra_id' in data) ||
        data.obra_id == null ||
        (data.obra_id is string && data.obra_id.size() <= 100);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidObra(data, obraId) {
      return data.keys().hasAll(['id', 'nombre', 'activo']) &&
        data.keys().hasOnly(['id', 'nombre', 'activo']) &&
        data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 100 &&
        data.id == obraId &&
        data.nombre is string &&
        data.nombre.size() > 0 &&
        data.nombre.size() <= 200 &&
        isValidFlag(data.activo);
    }

    function isValidTarea(data, tareaId) {
      return data.keys().hasAll(['id', 'obra_id', 'fecha_semana', 'dia_semana', 'actividad', 'gremio', 'completada', 'fecha_creado']) &&
        data.keys().hasOnly(['id', 'obra_id', 'fecha_semana', 'dia_semana', 'actividad', 'gremio', 'completada', 'notas', 'trazo_data', 'fecha_creado']) &&
        data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 100 &&
        data.id == tareaId &&
        data.obra_id is string &&
        data.obra_id.size() > 0 &&
        data.obra_id.size() <= 100 &&
        data.fecha_semana is string &&
        data.fecha_semana.size() == 10 &&
        data.fecha_semana.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        isValidDiaSemana(data.dia_semana) &&
        data.actividad is string &&
        data.actividad.size() > 0 &&
        data.actividad.size() <= 1000 &&
        data.gremio is string &&
        data.gremio.size() > 0 &&
        data.gremio.size() <= 100 &&
        isValidFlag(data.completada) &&
        isValidOptionalNotas(data) &&
        isValidOptionalTrazoData(data) &&
        data.fecha_creado is string &&
        data.fecha_creado.size() >= 10 &&
        data.fecha_creado.size() <= 50 &&
        data.fecha_creado.matches('^\\d{4}-\\d{2}-\\d{2}T.*');
    }

    function isValidNota(data, notaId) {
      return data.keys().hasAll(['id', 'completada', 'fecha_creacion', 'tipo']) &&
        data.keys().hasOnly(['id', 'completada', 'fecha_creacion', 'tipo', 'texto', 'fecha_completada', 'trazo_data', 'prioridad', 'obra_id']) &&
        data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 100 &&
        data.id == notaId &&
        isValidFlag(data.completada) &&
        data.fecha_creacion is string &&
        data.fecha_creacion.size() >= 10 &&
        data.fecha_creacion.size() <= 50 &&
        data.fecha_creacion.matches('^\\d{4}-\\d{2}-\\d{2}T.*') &&
        isValidTipoNota(data.tipo) &&
        isValidOptionalTexto(data) &&
        isValidOptionalFechaCompletada(data) &&
        isValidOptionalTrazoData(data) &&
        isValidOptionalPrioridad(data) &&
        isValidOptionalObraId(data);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Root Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Legacy / Demo Data (Read-only for migration)
    match /obras/{obraId} {
      allow read: if true;
      allow write: if false;
    }

    match /tareas/{tareaId} {
      allow read: if true;
      allow write: if false;
    }

    // Shared Gremios / Subcontratistas across all corporate users
    match /gremios/{gremioId} {
      allow read: if true;
      allow create, update: if request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.nombre.size() <= 100;
      allow delete: if true;
    }

    // Per-User Isolated Data
    match /users/{userId} {
      allow read, write: if isValidUserId(userId);

      match /obras/{obraId} {
        allow read, delete: if isValidUserId(userId);

        allow create: if isValidUserId(userId) &&
          isValidObra(request.resource.data, obraId);

        allow update: if isValidUserId(userId) &&
          isValidObra(request.resource.data, obraId) &&
          request.resource.data.id == resource.data.id;
      }

      match /tareas/{tareaId} {
        allow read, delete: if isValidUserId(userId);

        allow create: if isValidUserId(userId) &&
          isValidTarea(request.resource.data, tareaId);

        allow update: if isValidUserId(userId) &&
          isValidTarea(request.resource.data, tareaId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.fecha_creado == resource.data.fecha_creado;
      }

      match /notas/{notaId} {
        allow read, delete: if isValidUserId(userId);

        allow create: if isValidUserId(userId) &&
          isValidNota(request.resource.data, notaId);

        allow update: if isValidUserId(userId) &&
          isValidNota(request.resource.data, notaId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.fecha_creacion == resource.data.fecha_creacion;
      }
    }
  }
}
